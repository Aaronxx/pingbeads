/* 人偶仿宋16 子集字体（仅含界面用到的字符，子集化后 17KB woff2）
   来源：猫啃网 人偶仿宋16 1.1.1，免费商用（OFL）
   子集范围：界面汉字 + 标点 + 字母数字，共 273 字符
   说明书面板不使用此字体（保持默认易读） */
@font-face {
  font-family: 'RenOuFangSong';
  src: url('data:font/woff2;charset=utf-8;base64,') format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}
