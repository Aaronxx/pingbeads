/* components/imagePicker/imagePicker.wxss */

.image-picker {
  width: 100%;
}

.picker-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 300rpx;
  background-color: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  margin: 0 auto;
}

.picker-button:active {
  background-color: #eeeeee;
}

.icon-plus {
  font-size: 80rpx;
  color: #999;
  line-height: 1;
}

.picker-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #999;
}

.image-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-image {
  width: 100%;
  max-height: 500rpx;
  border-radius: 16rpx;
}

.preview-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  padding: 10rpx 30rpx;
  font-size: 26rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
}

.action-btn.delete {
  background-color: #ff4d4f;
}
