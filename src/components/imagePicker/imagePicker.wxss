/* components/imagePicker/imagePicker.wxss */

.image-picker {
  display: inline-block;
}

/* 选择按钮 - 可爱粉色风格 */
.picker-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff9ecd 0%, #ff6bb3 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 179, 0.4);
  border: none;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.picker-button:active {
  transform: translateY(1rpx);
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 179, 0.3);
}

/* 按钮组 */
.picker-actions {
  display: flex;
  gap: 12rpx;
}

/* 清除按钮 - 红色 */
.picker-button.clear {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.35);
}

.picker-button.clear:active {
  box-shadow: 0 2rpx 6rpx rgba(239, 68, 68, 0.3);
}

/* 检测中状态 */
.picker-button.checking {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.4);
  animation: checkingPulse 1s ease-in-out infinite;
}

@keyframes checkingPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* 隐藏不需要的元素 */
.picker-text,
.image-preview,
.preview-actions {
  display: none;
}