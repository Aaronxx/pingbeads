<!--components/imagePicker/imagePicker.wxml-->
<view class="image-picker">
  <!-- 选择按钮（未选择图片时显示） -->
  <view
    wx:if="{{!hasImage && showPicker}}"
    class="picker-button"
    bindtap="chooseImage"
  >
    <text>选择图片</text>
  </view>

  <!-- 重新选择/清除按钮（已选择图片时显示） -->
  <view wx:if="{{hasImage}}" class="picker-actions">
    <view class="picker-button" bindtap="reselectImage">
      <text>重选</text>
    </view>
    <view class="picker-button clear" bindtap="clearImage">
      <text>清除</text>
    </view>
  </view>
</view>
