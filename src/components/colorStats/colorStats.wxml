<!--components/colorStats/colorStats.wxml-->
<view class="color-stats">
  <!-- 颜色按钮列表 - 每行5个 -->
  <view wx:if="{{stats}}" class="color-buttons">
    <view
      wx:for="{{stats.sortedByCount}}"
      wx:key="code"
      class="color-btn"
      bindtap="handleCodeTap"
      data-code="{{item.code}}"
    >
      <view 
        class="color-btn-inner {{highlightCode === item.code ? 'highlight' : ''}}"
        style="background-color: {{item.hex}};"
      >
        <text class="color-btn-text {{item.isLight ? 'dark-text' : ''}}">{{item.displayCode}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!stats}}" class="empty-state">
    <text>暂无统计数据</text>
  </view>
</view>