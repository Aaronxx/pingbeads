/* components/colorStats/colorStats.wxss */

.color-stats {
  width: 100%;
  padding: 16rpx;
  box-sizing: border-box;
}

/* 颜色按钮列表 - 每行5个 */
.color-buttons {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  gap: 20rpx;
}

/* 按钮容器 */
.color-btn {
  width: calc(20% - 16rpx);
  height: 64rpx;
  box-sizing: border-box;
}

/* 玻璃拟态按钮 */
.color-btn-inner {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  /* 玻璃拟态特点 */
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  /* 亮边框 + 内部阴影 */
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3),
    0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

/* 顶部高光 */
.color-btn-inner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 40%;
  background: linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.4) 0%,
    rgba(255, 255, 255, 0.1) 100%
  );
  border-radius: 24rpx 24rpx 60% 60%;
}

.color-btn-inner:active {
  background: rgba(255, 255, 255, 0.35);
}

.color-btn-inner.highlight {
  border: 2rpx solid rgba(59, 130, 246, 0.8);
  box-shadow: 
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.3),
    0 0 0 4rpx rgba(59, 130, 246, 0.3),
    0 4rpx 16rpx rgba(59, 130, 246, 0.3);
}

/* 文字 */
.color-btn-text {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.color-btn-text.dark-text {
  color: #333;
  text-shadow: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  color: #94a3b8;
  font-size: 28rpx;
}