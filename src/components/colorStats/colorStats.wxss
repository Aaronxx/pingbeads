/* components/colorStats/colorStats.wxss */

.color-stats {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.stats-summary {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-item .label {
  font-size: 24rpx;
  color: #666;
}

.summary-item .value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.stats-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.sort-toggle {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  background-color: #f0f0f0;
  border-radius: 4rpx;
}

.color-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.color-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-bottom: 1rpx solid #eee;
  transition: background-color 0.2s;
}

.color-item:active {
  background-color: #f5f5f5;
}

.color-item.highlight {
  background-color: #fff3e0;
}

.color-swatch {
  width: 48rpx;
  height: 48rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
  border: 1rpx solid #ddd;
}

.color-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.color-code {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.color-count {
  font-size: 24rpx;
  color: #666;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  color: #999;
  font-size: 28rpx;
}
