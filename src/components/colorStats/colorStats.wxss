/* components/colorStats/colorStats.wxss */

/* 变量 */
page {
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --border-light: #e2e8f0;
  --bg-light: #f8fafc;
}

.color-stats {
  width: 100%;
  padding: 0;
  box-sizing: border-box;
}

/* 统计摘要 */
.stats-summary {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary-item .label {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 500;
}

.summary-item .value {
  font-size: 36rpx;
  font-weight: 700;
  color: #3b82f6;
}

/* 颜色列表 */
.color-list {
  max-height: 500rpx;
  overflow-y: auto;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx;
}

.color-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #fff;
  border: 1rpx solid var(--border-light);
  border-radius: 10rpx;
  transition: all 0.2s ease;
  flex: 0 0 calc(50% - 8rpx);
  box-sizing: border-box;
}

.color-item:nth-child(2n) {
  flex: 0 0 calc(50% - 8rpx);
}

.color-item:active {
  background: var(--bg-light);
  transform: scale(0.98);
}

.color-item.highlight {
  border-color: #3b82f6;
  box-shadow: 0 0 0 3rpx rgba(59, 130, 246, 0.15);
}

/* 色块 */
.color-swatch {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 颜色信息 */
.color-info {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-width: 0;
}

.color-code {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.color-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  color: #94a3b8;
  font-size: 28rpx;
}