/* components/colorStats/colorStats.wxss */

.color-stats {
  width: 100%;
  padding: 12rpx;
  box-sizing: border-box;
}

/* 颜色按钮列表 - 每行5个 */
.color-buttons {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}

/* 按钮容器 */
.color-btn {
  width: 20%;
  height: 60rpx;
  box-sizing: border-box;
}

/* 圆角按钮 */
.color-btn-inner {
  width: 100%;
  height: 100%;
  display: table;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.color-btn-inner.highlight {
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx #3b82f6;
}

/* 文字 - 用 table-cell 垂直居中 */
.color-btn-text {
  display: table-cell;
  vertical-align: middle;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.color-btn-text.dark-text {
  color: #333;
  text-shadow: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
  color: #94a3b8;
  font-size: 28rpx;
}