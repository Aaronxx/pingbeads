/* components/mosaicCanvas/mosaicCanvas.wxss */

/* 渐变背景色板 */
.mosaic-wrapper {
  --cell-border: rgba(255, 255, 255, 0.15);
  --shadow-subtle: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.mosaic-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e7eb 100%);
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
  z-index: 1;
}

/* 滚动区域 */
.mosaic-scroll {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  transform-origin: center center;
  transition: transform 0.15s ease-out;
  touch-action: pan-x pan-y;
}

/* Canvas 容器 */
.canvas-container {
  position: relative;
  z-index: 1;
  transform-origin: center center;
}

/* 网格容器 */
.mosaic-grid {
  position: relative;
  box-shadow: var(--shadow-subtle);
}

/* 单元格 */
.mosaic-cell {
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  border: 0.5rpx solid var(--cell-border);
  overflow: hidden;
  transition: all 0.15s ease;
}

.mosaic-cell.dimmed {
  opacity: 0.25;
  filter: grayscale(80%);
}

.mosaic-cell.highlight {
  box-shadow: 
    inset 0 0 0 2rpx #fff,
    0 0 12rpx rgba(22, 119, 255, 0.6);
  z-index: 10;
}

/* 色号文字 */
.cell-code {
  color: #fff;
  font-weight: 700;
  text-shadow: 
    0 1rpx 2rpx rgba(0, 0, 0, 0.5),
    0 -1rpx 0 rgba(0, 0, 0, 0.3);
  text-align: center;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  padding: 2rpx;
  letter-spacing: 0.5rpx;
}

.mosaic-grid .cell-code {
  font-size: 16rpx;
}

.mosaic-cell.small .cell-code {
  display: none;
}

/* 空状态提示 */
.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: rgba(0, 0, 0, 0.4);
  font-size: 28rpx;
  text-align: center;
}

/* 自由裁剪确认按钮（左下角悬浮，精致显眼） */
.crop-confirm-btn {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(255, 158, 205, 0.7) 0%, rgba(255, 107, 179, 0.7) 100%);
  color: #fff;
  font-size: 44rpx;
  border-radius: 50%;
  box-shadow:
    0 8rpx 24rpx rgba(255, 107, 179, 0.5),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.4);
  z-index: 20;
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: auto;
}

/* emoji 在 text 标签里默认 line-height>1 会顶偏上，强制行高=字号才能真正居中；
   emoji 字形视觉重心偏下，再上提 1rpx 修正 */
.crop-confirm-btn text {
  line-height: 1;
  margin-top: -1rpx;
}

.crop-confirm-btn:active {
  transform: scale(0.92);
}

/* 裁剪模式遮罩层：覆盖 canvas，接收拖动事件 */
.crop-mask-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 15;
}

/* 裁剪框：box-shadow 无限大外阴影=灰色遮罩，框内透明 */
.crop-window {
  position: absolute;
  left: 0;
  top: 0;
  box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.5);
  border: 2px solid #fff;
  box-sizing: border-box;
  pointer-events: none;
}