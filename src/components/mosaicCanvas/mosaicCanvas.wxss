/* components/mosaicCanvas/mosaicCanvas.wxss */

.mosaic-wrapper {
  position: relative;
  width: 100%;
  height: 500rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.mosaic-wrapper.fullscreen {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  height: 100vh;
  border-radius: 0;
}

.fullscreen-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 100;
  padding: 10rpx 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.mosaic-scroll {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  transform-origin: center center;
  transition: transform 0.1s ease-out;
}

.mosaic-grid {
  position: relative;
}

.mosaic-cell {
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  border: 0.5px solid rgba(0, 0, 0, 0.1);
}

.mosaic-cell.dimmed {
  opacity: 0.3;
}

.cell-code {
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  text-shadow: 0 0 2rpx rgba(0, 0, 0, 0.9);
}

.processing-tip,
.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #999;
  font-size: 28rpx;
  text-align: center;
}
