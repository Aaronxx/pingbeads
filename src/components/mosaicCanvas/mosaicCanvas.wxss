/* components/mosaicCanvas/mosaicCanvas.wxss */

/* 渐变背景色板 */
page {
  --cell-border: rgba(255, 255, 255, 0.15);
  --shadow-subtle: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.mosaic-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e7eb 100%);
  border-radius: 16rpx;
  overflow: visible;
  box-sizing: border-box;
}

/* 滚动区域 */
.mosaic-scroll {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  transform-origin: center center;
  transition: transform 0.15s ease-out;
  touch-action: pan-x pan-y;
}

/* Canvas 容器 */
.canvas-container {
  transform-origin: center center;
}

/* 网格容器 */
.mosaic-grid {
  position: relative;
  box-shadow: var(--shadow-subtle);
}

/* 单元格 */
.mosaic-cell {
  position: absolute;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  border: 0.5rpx solid var(--cell-border);
  overflow: hidden;
  transition: all 0.15s ease;
}

.mosaic-cell.dimmed {
  opacity: 0.25;
  filter: grayscale(80%);
}

.mosaic-cell.highlight {
  box-shadow: 
    inset 0 0 0 2rpx #fff,
    0 0 12rpx rgba(22, 119, 255, 0.6);
  z-index: 10;
}

/* 色号文字 */
.cell-code {
  color: #fff;
  font-weight: 700;
  text-shadow: 
    0 1rpx 2rpx rgba(0, 0, 0, 0.5),
    0 -1rpx 0 rgba(0, 0, 0, 0.3);
  text-align: center;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 20rpx;
  padding: 2rpx;
  letter-spacing: 0.5rpx;
}

.mosaic-grid .cell-code {
  font-size: 16rpx;
}

.mosaic-cell.small .cell-code {
  display: none;
}

/* 处理中/空状态提示 */
.processing-tip,
.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: rgba(0, 0, 0, 0.4);
  font-size: 28rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.processing-tip::before {
  content: '';
  display: block;
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto;
  border: 4rpx solid #e8eaed;
  border-top-color: #1677ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}