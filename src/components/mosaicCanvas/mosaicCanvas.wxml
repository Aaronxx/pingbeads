<!--components/mosaicCanvas/mosaicCanvas.wxml-->
<view 
  class="mosaic-wrapper {{isFullscreen ? 'fullscreen' : ''}}" 
  style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
>
  <!-- 隐藏的 canvas 用于获取像素数据 -->
  <canvas type="2d" id="pixel-canvas" style="width: 1px; height: 1px; position: absolute; opacity: 0;" />

  <!-- 全屏按钮 -->
  <view class="fullscreen-btn" bindtap="toggleFullscreen">
    <text>{{isFullscreen ? '退出全屏' : '全屏'}}</text>
  </view>

  <!-- 使用 Canvas 渲染马赛克（解决 DOM 数量限制） -->
  <view class="canvas-container" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;">
    <canvas 
      type="2d" 
      id="mosaic-render-canvas" 
      style="width: 100%; height: 100%;"
      bindtouchstart="handleTouchStart"
      bindtouchmove="handleTouchMove"
      bindtouchend="handleTouchEnd"
    />
  </view>

  <!-- 处理中提示 -->
  <view wx:if="{{isProcessing}}" class="processing-tip">
    <text>正在处理图片...</text>
  </view>

  <!-- 空状态提示 -->
  <view wx:elif="{{!imagePath}}" class="empty-tip">
    <text>请先选择图片</text>
  </view>
</view>
