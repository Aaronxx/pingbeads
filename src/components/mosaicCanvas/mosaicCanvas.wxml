<!--components/mosaicCanvas/mosaicCanvas.wxml-->
<view
  class="mosaic-wrapper"
  id="mosaic-wrapper"
  style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
  catchtouchmove="preventBubbling"
>
  <!-- 隐藏的 canvas 用于获取像素数据 -->
  <canvas type="2d" id="pixel-canvas" style="width: 1px; height: 1px; position: absolute; opacity: 0;" />

  <!-- 使用 Canvas 渲染马赛克（解决 DOM 数量限制） -->
  <view class="canvas-container" id="canvas-container" style="width: {{canvasWidth}}px; height: {{canvasHeight}}px; transform: translate({{offsetX}}px, {{offsetY}}px) scale({{scale}});" catchtouchmove="preventBubbling">
    <canvas
      type="2d"
      id="mosaic-render-canvas"
      style="width: 100%; height: 100%;"
      bindtouchstart="handleTouchStart"
      catchtouchmove="handleTouchMove"
      bindtouchend="handleTouchEnd"
    />
  </view>

  <!-- 裁剪模式：遮罩 + 裁剪框 + 剪刀按钮（cropMode 控制全部显示） -->
  <view wx:if="{{cropMode}}"
        class="crop-mask-layer"
        bindtouchstart="handleTouchStart"
        catchtouchmove="handleTouchMove"
        bindtouchend="handleTouchEnd">
    <view class="crop-window" style="width: {{cropWinW}}px; height: {{cropWinH}}px; transform: translate({{cropWinX}}px, {{cropWinY}}px);"></view>
  </view>
  <view wx:if="{{cropMode}}"
        class="crop-confirm-btn"
        catchtap="confirmCrop">
    <text>✂️</text>
  </view>
  <view wx:if="{{cropMode}}"
        class="crop-cancel-btn"
        catchtap="cancelCrop">
    <text>✕</text>
  </view>


  <!-- 空状态提示 -->
  <view wx:if="{{!imagePath}}" class="empty-tip">
    <text>请先选择图片</text>
  </view>
</view>
