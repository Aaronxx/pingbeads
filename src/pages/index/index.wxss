/* pages/index/index.wxss */

/* ========================
   变量定义 - 可爱风格配色
   ======================== */
.container {
  --primary: #ff9ecd;
  --primary-dark: #ff6bb3;
  --primary-light: #ffb6d9;
  --accent: #ffd700;
  --bg-main: #fff5f8;
  --bg-card: #ffffff;
  --bg-secondary: #fff0f5;
  --text-primary: #5c4033;
  --text-secondary: #8b7355;
  --text-muted: #c4a484;
  --border-light: #ffe4ec;
  --shadow-soft: 0 4rpx 20rpx rgba(255, 158, 205, 0.25);
  --shadow-float: 0 8rpx 32rpx rgba(255, 158, 205, 0.35);
  --radius-soft: 24rpx;
  --radius-round: 50%;
}

.container {
  min-height: 100vh;
  background: var(--bg-main);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

/* ========================
   顶部固定栏（简化后）
   ======================== */
.top-fixed-bar {
  width: 95%;
  position: fixed;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(180deg, #ffffff 0%, #fff5f8 100%);
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: var(--shadow-soft);
  z-index: 1000;
  padding: 16rpx 0;
}

.button-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 92%;
  margin: 0 auto;
  padding: 8rpx 0;
}

.button-left,
.button-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* ========================
   模式切换按钮
   ======================== */
.mode-switch-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #fff 0%, #fff0f5 100%);
  border: 2rpx solid var(--border-light);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.mode-switch-btn .mode-icon {
  font-size: 28rpx;
}

.mode-switch-btn .mode-text {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.mode-switch-btn.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-color: var(--primary);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 179, 0.4);
}

.mode-switch-btn.active .mode-text {
  color: #fff;
}

/* ========================
   下拉按钮
   ======================== */
.dropdown-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #fff 0%, #fff0f5 100%);
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
  min-width: 100rpx;
}

.dropdown-label {
  font-size: 18rpx;
  color: var(--text-muted);
}

.dropdown-value {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}

/* ========================
   主预览区域
   ======================== */
.main-wrapper {
  width: 95%;
  height: 75vh;
  margin-top: 130rpx;
  background: var(--bg-card);
  border-radius: var(--radius-soft);
  box-shadow: var(--shadow-soft);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* ========================
   小动物贴纸层
   ======================== */
/* 自定义 loading 覆盖层 */
.loading-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  background: rgba(0, 0, 0, 0);
  transition: background 0.3s ease;
}
.loading-overlay.show {
  pointer-events: auto;
  background: rgba(0, 0, 0, 0.15);
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  min-height: 260rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
  transform: scale(0.8);
  opacity: 0;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
  backdrop-filter: blur(20rpx);
}
.loading-overlay.show .loading-box {
  transform: scale(1);
  opacity: 1;
}

.loading-spinner-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 40rpx;
  margin-bottom: 24rpx;
}

.spinner-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  animation: dot-bounce 1.2s ease-in-out infinite;
}
.dot-1 {
  background: #f472b6;
  animation-delay: 0s;
}
.dot-2 {
  background: #ec4899;
  animation-delay: 0.2s;
}
.dot-3 {
  background: #db2777;
  animation-delay: 0.4s;
}

@keyframes dot-bounce {
  0%, 80%, 100% {
    transform: scale(0.5);
    opacity: 0.3;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.loading-text {
  font-size: 24rpx;
  color: #666;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

.loading-progress-bar {
  width: 160rpx;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.loading-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f472b6, #ec4899, #db2777);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 分块导出专属粉色 loading */
.export-loading .loading-box {
  background: rgba(244, 114, 182, 0.5);
  box-shadow: 0 8rpx 40rpx rgba(236, 72, 153, 0.3);
  backdrop-filter: blur(20rpx);
}
.export-loading .loading-text {
  color: #ffffff;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}
.export-loading .spinner-dot {
  background: #ffffff;
}
.export-loading .loading-progress-bar {
  background: rgba(255, 255, 255, 0.3);
}
.export-loading .loading-progress-fill {
  background: #ffffff;
}

/* 成功提示样式 */
.success-toast {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  transform: scale(0.8);
  transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.success-toast.show {
  pointer-events: auto;
  opacity: 1;
  transform: scale(1);
}

.success-toast-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  min-height: 260rpx;
  padding: 30rpx;
  background: rgba(244, 114, 182, 0.5);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(236, 72, 153, 0.3);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(20rpx);
}

.success-icon {
  font-size: 80rpx;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.success-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
  white-space: nowrap;
}

.sticker-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.sticker {
  position: absolute;
  font-size: 40rpx;
  opacity: 0.65;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
  animation: float 6s ease-in-out infinite;
}

.sticker-1 { animation-delay: 0s; }
.sticker-2 { animation-delay: 1s; }
.sticker-3 { animation-delay: 2s; }
.sticker-4 { animation-delay: 3s; }
.sticker-5 { animation-delay: 4s; }
.sticker-6 { animation-delay: 5s; }
.sticker-7 { animation-delay: 0.5s; }
.sticker-8 { animation-delay: 1.5s; }

@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-8rpx) rotate(5deg);
  }
  75% {
    transform: translateY(8rpx) rotate(-5deg);
  }
}

/* ========================
   预览区
   ======================== */
.preview-area {
  width: 92%;
  flex: 1;
  margin: 16rpx auto;
  border-radius: 20rpx;
  background: var(--bg-card);
  overflow: hidden;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
  box-shadow: inset 0 2rpx 8rpx rgba(255, 158, 205, 0.1);
}

/* 占位符 */
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  z-index: 1;
}

.placeholder-icon {
  font-size: 100rpx;
  opacity: 0.5;
}

.placeholder-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* ========================
   悬浮设置按钮（右下角）
   ======================== */
.fab-button {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #ff9ecd 0%, #ff6bb3 50%, #ff5ca8 100%);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 179, 0.5), 0 4rpx 8rpx rgba(255, 107, 179, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.fab-button::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  height: 40%;
  background: linear-gradient(180deg, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0) 100%);
  border-radius: 20rpx 20rpx 50% 50%;
  pointer-events: none;
}

.fab-button:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 179, 0.4);
}

.fab-icon {
  font-size: 48rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.fab-close {
  background: linear-gradient(135deg, #a0a0a0 0%, #808080 50%, #606060 100%);
  border-color: rgba(255, 255, 255, 0.3);
}

.fab-close .fab-icon {
  font-size: 36rpx;
}

/* ========================
   功能面板遮罩
   ======================== */
.settings-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1001;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.settings-overlay.show {
  opacity: 1;
  visibility: visible;
}

/* ========================
   功能面板（从底部升起）
   ======================== */
.settings-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #ffffff 0%, #fff5f8 100%);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(255, 158, 205, 0.3);
  z-index: 1002;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), max-height 0.3s ease;
  max-height: 50vh;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
}

.settings-panel.show {
  transform: translateY(0);
}

/* 面板最小化状态 */
.settings-panel.minimized {
  max-height: 280rpx;
  min-height: 280rpx;
}

.settings-panel.minimized .panel-content {
  display: none;
}

/* 拖动指示条 */
.panel-handle {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.handle-bar {
  width: 80rpx;
  height: 8rpx;
  background: linear-gradient(90deg, transparent, var(--border-light), transparent);
  border-radius: 4rpx;
}

/* 面板标题栏 */
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.panel-title-icon {
  font-size: 36rpx;
}

.panel-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.panel-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  border-radius: var(--radius-round);
  font-size: 28rpx;
  color: var(--text-secondary);
}

.panel-close:active {
  background: var(--border-light);
}

/* 面板内容 */
.panel-content {
  flex: 1;
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

/* 设置组 */
.setting-group {
  margin-bottom: 20rpx;
}

.group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.actual-size-inline {
  font-size: 22rpx;
  color: #9ca3af;
  font-weight: 400;
}

/* 开关按钮行 */
.switch-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.switch-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #fff 0%, #fff0f5 100%);
  border: 2rpx solid var(--border-light);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  transition: all 0.3s ease;
}

.switch-btn.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-color: var(--primary);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 179, 0.4);
}

.switch-btn:active {
  transform: scale(0.95);
}

/* 鲜艳度滑块 */
.vibrant-control {
  position: relative;
  display: flex;
  align-items: center;
  padding: 12rpx 120rpx 12rpx 48rpx;
  background: linear-gradient(135deg, #fff 0%, #fff0f5 100%);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.vibrant-label-left {
  position: absolute;
  left: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 18rpx;
  color: var(--text-muted);
}

.vibrant-label-right {
  position: absolute;
  right: 80rpx !important;
  top: 50%;
  transform: translateY(-50%);
  font-size: 18rpx;
  color: var(--text-muted);
}

.vibrant-slider-outer {
  width: 100%;
  height: 60rpx;
}

.vibrant-slider-wrapper {
  width: 90%;
  height: 100%;
  margin: 0 auto;
  position: relative;
  display: flex;
  align-items: center;
}

.vibrant-slider-wrapper slider {
  width: 100%;
  margin: 0;
  position: relative;
  z-index: 2;
}

/* 鲜艳度滑块中心标记 - 在滑块之下 */
.vibrant-center-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 4rpx;
  height: 24rpx;
  background: linear-gradient(180deg, #ff9ecd 0%, #ff6bb3 100%);
  border-radius: 2rpx;
  pointer-events: none;
  z-index: 1;
}

.vibrant-value {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 64rpx;
  text-align: center;
  color: var(--text-secondary);
}

.vibrant-value.neg {
  color: #ff6b6b;
}

.vibrant-value.pos {
  color: #10b981;
}

/* ===== 自定义网格大小 ===== */
.custom-grid-control {
  padding: 16rpx 0;
}

.grid-checkbox-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* ========================
   网格预设控件
   ======================== */
.grid-preset-control {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.preset-hint {
  font-size: 22rpx;
  color: #9ca3af;
}

.preset-picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #fff 0%, #fff0f5 100%);
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.preset-picker-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #fff0f5 0%, #ffe4ec 100%);
}

.preset-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.preset-value {
  font-size: 26rpx;
  color: var(--primary-dark);
  font-weight: 600;
}

.preset-arrow {
  font-size: 18rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

.grid-current-value {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--primary-dark);
  font-weight: 700;
}

/* 自定义可爱 checkbox */
.grid-checkbox-label checkbox .wx-checkbox-input {
  border-radius: 8rpx !important;
  border: 3rpx solid var(--primary-light) !important;
  width: 36rpx !important;
  height: 36rpx !important;
}

.grid-checkbox-label checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: var(--primary) !important;
  border-color: var(--primary) !important;
}

.grid-checkbox-label checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  color: #fff !important;
  font-size: 22rpx !important;
}

.grid-control-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 12rpx 120rpx 12rpx 48rpx;
  background: linear-gradient(135deg, #fff 0%, #fff0f5 100%);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.grid-control-row.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.grid-min-label,
.grid-max-label {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  font-size: 18rpx;
  color: var(--text-muted);
}

.grid-min-label {
  left: 12rpx;
}

.grid-max-label {
  right: 80rpx;
}

.grid-slider-outer {
  width: 100%;
  height: 60rpx;
}

.grid-slider-wrapper {
  width: 90%;
  height: 100%;
  margin: 0 auto;
  position: relative;
  display: flex;
  align-items: center;
}

.grid-slider-wrapper slider {
  width: 100%;
  margin: 0;
  position: relative;
  z-index: 2;
}

/* 替换表单 */
.replace-form {
  background: linear-gradient(135deg, #fff 0%, #fff0f5 100%);
  border-radius: 20rpx;
  padding: 24rpx;
}

.replace-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.replace-field {
  flex: 1;
}

.field-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
  display: block;
}

.replace-input {
  width: 100%;
  height: 64rpx;
  padding: 0 16rpx;
  background: #fff;
  border: 2rpx solid var(--border-light);
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.replace-input:focus {
  border-color: var(--primary);
}

.replace-arrow {
  font-size: 32rpx;
  color: var(--primary);
  margin-top: 32rpx;
}

/* 替换选项同一行 */
.replace-options-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
}

.replace-radio-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.radio-item-inline {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  white-space: nowrap;
}

.radio-item-inline radio {
  transform: scale(0.85);
}

.region-input-inline {
  flex: 1;
  min-width: 120rpx;
  max-width: 180rpx;
  height: 52rpx;
  padding: 0 12rpx;
  background: #fff;
  border: 2rpx solid var(--primary);
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

/* 小型替换按钮 */
.confirm-btn-small {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
  flex-shrink: 0;
}

.confirm-btn-small text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.confirm-btn-small:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.undo-btn {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
}

/* ========================
   底部统计面板
   ======================== */
.stats-panel {
  width: 95%;
  background: var(--bg-card);
  border-radius: var(--radius-soft);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
  margin-top: 12rpx;
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.stats-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stats-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ========================
   底部悬浮保存按钮
   ======================== */
.bottom-fixed-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(255,245,248,0.98) 100%);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 0 20rpx;
}

.save-btn-full {
  width: 60%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 179, 0.4);
  transition: all 0.3s ease;
}

.save-btn-full:active {
  transform: scale(0.98);
}

/* 导出中状态 */
.save-btn-full.exporting {
  background: linear-gradient(135deg, #f472b6 0%, #ec4899 50%, #db2777 100%);
  box-shadow: 0 4rpx 24rpx rgba(236, 72, 153, 0.5);
  animation: savePulse 1.5s ease-in-out infinite;
  pointer-events: none;
}

.btn-exporting {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.export-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.25);
  border-top-color: #fff;
  border-bottom-color: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  animation: spin 0.7s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

/* 有分割模式时保存按钮变小 */
.save-btn-full.has-split {
  width: 52%;
  font-size: 26rpx;
}

/* 分块导出按钮 */
.split-btn {
  width: 32%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #a78bfa 0%, #7c3aed 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(124, 58, 237, 0.35);
  transition: all 0.3s ease;
}

.split-btn:active {
  transform: scale(0.98);
}

.split-btn.has-mode {
  background: linear-gradient(135deg, #c4b5fd 0%, #8b5cf6 100%);
  font-size: 24rpx;
}

/* 分块导出弹窗遮罩 */
.split-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s ease;
}

.split-popup-mask.show {
  opacity: 1;
  visibility: visible;
}

/* 分块导出弹窗 */
.split-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.split-popup.show {
  transform: translateY(0);
}

.split-popup-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.split-popup-option {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  margin-bottom: 12rpx;
  background: #fafafa;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.split-popup-option:active {
  background: #f0e6ff;
  border-color: #a78bfa;
}

.split-option-icon {
  font-size: 40rpx;
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}

.split-option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.split-option-desc {
  font-size: 22rpx;
  color: #999;
  flex: 1;
}

.split-popup-cancel {
  text-align: center;
  padding: 28rpx;
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
  margin-top: 8rpx;
}

.split-popup-cancel:active {
  color: #666;
  background: #f5f5f5;
  border-radius: 20rpx;
}

@keyframes savePulse {
  0%, 100% { transform: scale(1); opacity: 1; box-shadow: 0 4rpx 24rpx rgba(236, 72, 153, 0.5); }
  50% { transform: scale(0.96); opacity: 0.9; box-shadow: 0 2rpx 16rpx rgba(236, 72, 153, 0.3); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 为底部按钮留出空间 */
.container {
  padding-bottom: 140rpx;
}

/* ========================
   响应式
   ======================== */
@media (max-width: 750rpx) {
  .button-row {
    flex-wrap: wrap;
    gap: 12rpx;
  }

  .button-left,
  .button-right {
    flex: 1;
    min-width: 0;
  }

  .dropdown-btn {
    min-width: 80rpx;
    padding: 8rpx 12rpx;
  }

  .panel-content {
    padding: 20rpx 24rpx;
  }

  .switch-btn {
    padding: 12rpx 16rpx;
    font-size: 24rpx;
  }

  .sticker {
    font-size: 32rpx;
  }
}

/* 超小屏幕 */
@media (max-width: 600rpx) {
  .fab-button {
    width: 80rpx;
    height: 80rpx;
    right: 24rpx;
    bottom: 140rpx;
  }

  .fab-icon {
    font-size: 36rpx;
  }

  .replace-row {
    flex-direction: column;
    gap: 8rpx;
  }

  .replace-arrow {
    margin: 0;
    transform: rotate(90deg);
  }
}

/* 聚类调试面板 */
.agg-param-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.agg-param-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  width: 180rpx;
  flex-shrink: 0;
}

.agg-param-slider {
  flex: 1;
  margin: 0;
}

.agg-reset-btn {
  font-size: 24rpx;
  color: #ff7eb3;
  text-align: center;
  padding: 12rpx 0;
  margin-top: 8rpx;
  border: 1rpx solid #ffc3de;
  border-radius: 8rpx;
}
