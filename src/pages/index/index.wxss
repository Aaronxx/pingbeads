  padding: 0 16rpx;
  background: linear-gradient(135deg, #ff9ecd 0%, #ff6bb3 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 179, 0.3);
  display: flex;
