}

.help-new-4:active {
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 179, 0.5);
}

/* 样式E：圆形渐变问号（深色） */
.help-new-5 {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #5c4033 0%, #8b7355 100%);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(92, 64, 51, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.help-new-5 .help-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.help-new-5:active {
  background: linear-gradient(135deg, #8b7355 0%, #a08060 100%);
  box-shadow: 0 6rpx 20rpx rgba(92, 64, 51, 0.4);
}

/* 样式F：圆形渐变问号（亮色带小点） */
.help-new-6 {
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ff9ecd 100%);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(255, 215, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.help-new-6 .help-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.help-new-6 .help-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 12rpx;
  height: 12rpx;
  background: #ff4d94;
  border-radius: 50%;
  border: 2rpx solid #fff;
  animation: dot-blink 2s ease-in-out infinite;
}

@keyframes dot-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.help-new-6:active {
  box-shadow: 0 6rpx 20rpx rgba(255, 215, 0, 0.5);
}

/* ========================
   帮助面板遮罩层
   ======================== */
.help-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.help-overlay.show {
  opacity: 1;
  visibility: visible;
}

/* ========================
   帮助面板
   ======================== */
.help-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #ffffff 0%, #fff5f8 100%);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(255, 158, 205, 0.3);
  z-index: 2001;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.help-panel.show {
  transform: translateY(0);
}

/* 面板内容 */
.help-panel .panel-content {
  flex: 1;
  padding: 24rpx 64rpx;
  overflow-y: auto;
  box-sizing: border-box;
  word-break: break-all;
}

/* 帮助内容区域 */
.help-section {
  margin-bottom: 32rpx;
}

.help-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--border-light);
}

.help-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.help-item:last-child {
  border-bottom: none;
}

.help-item-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  width: 48rpx;
  text-align: center;
}

.help-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.help-item-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.help-item-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 帮助面板子项目样式 */
.help-sub-items {
  margin-top: 12rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--border-light);
}

.help-sub-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 0;
}

.help-sub-item:first-child {
  padding-top: 0;
}

.help-sub-item:last-child {
  padding-bottom: 0;
}

.help-sub-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  width: 32rpx;
  text-align: center;
}

.help-sub-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.help-sub-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.help-sub-desc {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* 帮助面板底部按钮 */
.help-footer {
  padding: 24rpx 64rpx 48rpx;
  border-top: 1rpx solid var(--border-light);
  display: flex;
  justify-content: center;
  align-items: center;
}

.help-confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70%;
  height: 72rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  border-radius: var(--radius-soft);
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 179, 0.4);
  margin: 0 auto;
}

.help-confirm-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}
