/* pages/index/index.wxss */

/* 变量定义 */
page {
  --primary: #3b82f6;
  --primary-dark: #2563eb;
  --primary-light: #60a5fa;
  --bg-main: #f0f2f5;
  --bg-card: #ffffff;
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  --border-light: #e2e8f0;
  --shadow-sm: 0 1rpx 3rpx rgba(0, 0, 0, 0.08);
  --shadow-md: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
}

.container {
  min-height: 100vh;
  background: var(--bg-main);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

/* ========================
   大外框：宽95%，高98%
   ======================== */
.main-wrapper {
  width: 95%;
  height: 80vh;
  margin-top: 120rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* 碎花背景 - 大框剩余区域 */
.main-wrapper::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(59, 130, 246, 0.05) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(99, 102, 241, 0.04) 0%, transparent 40%),
    radial-gradient(circle at 40% 80%, rgba(16, 185, 129, 0.04) 0%, transparent 45%),
    radial-gradient(circle at 90% 70%, rgba(236, 72, 153, 0.03) 0%, transparent 35%),
    radial-gradient(circle at 10% 90%, rgba(245, 158, 11, 0.03) 0%, transparent 40%),
    url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%233b82f6' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  background-size: 
    100% 100%,
    100% 100%,
    100% 100%,
    100% 100%,
    100% 100%,
    40rpx 40rpx;
  background-position: center;
  pointer-events: none;
  z-index: 0;
}

/* ========================
   顶部固定栏
   ======================== */
.top-fixed-bar {
  width: 95%;
  position: fixed;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  background: var(--bg-card);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  box-shadow: var(--shadow-sm);
  z-index: 1000;
  padding: 16rpx 0;
}

/* ========================
   按钮行：宽度90%
   ======================== */
.button-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 90%;
  margin: 0 auto;
  padding: 12rpx 0;
  position: relative;
  z-index: 1;
}

.button-left {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.button-left .setting-items-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ========================
   特殊色开关行：与按钮行左对齐
   ======================== */
.special-color-row {
  display: flex;
  align-items: center;
  width: 90%;
  margin-left: 5%;
  padding: 8rpx 0;
  gap: 16rpx;
}

.special-hint {
  font-size: 20rpx;
  color: var(--text-muted);
}

.button-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 0 12rpx;
}

.button-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 操作按钮（替换、撤销） */
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.action-btn text {
  color: #fff;
}

/* 替换按钮 - 紫色 */
.replace-btn {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  box-shadow: 0 2rpx 8rpx rgba(139, 92, 246, 0.4);
}

.replace-btn.active {
  background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
}

.replace-btn:active {
  opacity: 0.8;
}

/* 撤销按钮 - 浅黄色 */
.undo-btn {
  background: linear-gradient(135deg, #fde047 0%, #facc15 100%);
  box-shadow: 0 2rpx 8rpx rgba(250, 204, 21, 0.4);
}

.undo-btn text {
  color: #713f12;
}

.undo-btn.disabled {
  opacity: 0.5;
}

.undo-btn.disabled text {
  color: #a16207;
}

.undo-btn:active:not(.disabled) {
  opacity: 0.8;
}

/* 替换面板 */
/* 替换面板 */
.replace-panel {
  display: flex;
  flex-direction: column;
  width: 90%;
  margin: 12rpx auto 0;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
  border-radius: 12rpx;
  gap: 12rpx;
}

.replace-hint {
  font-size: 24rpx;
  color: #6b7280;
  text-align: left;
}

.replace-inputs {
  display: flex;
  gap: 12rpx;
  flex: 1;
}

.replace-input {
  flex: 1;
  height: 60rpx;
  padding: 0 16rpx;
  background: #fff;
  border: 2rpx solid #d1d5db;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.region-input {
  border-color: #3b82f6;
}

.replace-region-input {
  display: flex;
}

.replace-options {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.replace-radio-group {
  display: flex;
  gap: 16rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #374151;
}

.replace-confirm {
  flex-shrink: 0;
}

.confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 185, 129, 0.4);
}

.confirm-btn text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.confirm-btn:active {
  opacity: 0.8;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.setting-label {
  font-size: 20rpx;
  color: var(--text-muted);
  white-space: nowrap;
}

.slider-mini {
  width: 80rpx;
}

/* 下拉框样式 */
.picker-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #f0f4ff 0%, #e8f4f8 100%);
  border-radius: 8rpx;
  min-width: 80rpx;
}

/* 智能模式切换按钮 */
.picker-box.mode-switch {
  background: linear-gradient(135deg, #e0e0e0 0%, #d0d0d0 100%);
}

.picker-box.mode-switch.active {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
}

.picker-box.mode-switch.active .picker-label,
.picker-box.mode-switch.active .picker-value {
  color: #fff;
}

.picker-label {
  font-size: 18rpx;
  color: var(--text-muted);
  margin-bottom: 2rpx;
}

.switch-label {
  font-size: 18rpx;
  color: var(--text-muted);
  margin-left: 8rpx;
}

.picker-value {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
}

/* ========================
   预览区：宽高90%
   ======================== */
.preview-area {
  width: 90%;
  flex: 1;
  margin: 16rpx auto 16rpx;
  border-radius: var(--radius-md);
  background: var(--bg-card);
  overflow: visible;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
  box-shadow: var(--shadow-sm);
}

/* 预览区背景纹理 */
.preview-area::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(45deg, #f1f5f9 25%, transparent 25%),
    linear-gradient(-45deg, #f1f5f9 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #f1f5f9 75%),
    linear-gradient(-45deg, transparent 75%, #f1f5f9 75%);
  background-size: 20rpx 20rpx;
  background-position: 0 0, 0 10rpx, 10rpx -10rpx, -10rpx 0;
  opacity: 0.5;
  pointer-events: none;
}

/* 占位符 */
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  z-index: 1;
}

.placeholder-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.placeholder-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* ========================
   底部统计面板
   ======================== */
.stats-panel {
  width: 95%;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  margin-top: 12rpx;
}

.stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.stats-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stats-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ========================
   底部悬浮框：与屏幕同宽
   ======================== */
.bottom-fixed-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 120rpx;
  background: var(--bg-card);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.save-btn-full {
  width: 60%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(59, 130, 246, 0.4);
}

.save-btn-full.disabled,
.save-btn-full.exporting {
  opacity: 0.6;
  background: linear-gradient(135deg, #93c5fd 0%, #60a5fa 100%);
}

.btn-text {
  display: inline-block;
}

.exporting-text {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 为底部按钮留出空间 */
.container {
  padding-bottom: 140rpx;
}

/* ========================
   响应式
   ======================== */
@media (max-width: 600rpx) {
  .button-center {
    gap: 10rpx;
  }
  
  .setting-label {
    display: none;
  }
  
  .slider-mini {
    width: 60rpx;
  }
}