<!--pages/index/index.wxml-->
<view class="container">
  <!-- ========================
     顶部固定栏（简化后）
     ======================== -->
  <view class="top-fixed-bar">
    <view class="button-row">
      <!-- 左侧：imagePicker 组件 + 原图/卡通模式切换 -->
      <view class="button-left">
        <!-- imagePicker 组件（自带选择/重选按钮） -->
        <imagePicker id="image-picker" bind:imageSelected="onImageSelected" bind:imageCleared="onImageCleared" />

        <!-- 原图/马赛克模式切换（始终显示） -->
        <view class="setting-item">
          <view class="mode-switch-btn {{processMode === 'mosaic' ? 'active' : ''}}" bindtap="toggleProcessMode">
            <text class="mode-icon">🎨</text>
            <text class="mode-text">{{processMode === 'mosaic' ? '马赛克' : '卡通'}}</text>
          </view>
        </view>

        <!-- 帮助按钮（双开书+星星） -->
        <view class="help-btn help-book-btn" bindtap="onHelpTap">
          <!-- 星星装饰（错落分布） -->
          <view class="book-stars">
            <view class="star star-1">✦</view>
            <view class="star star-2">✧</view>
            <view class="star star-3">✦</view>
            <view class="star star-4">✧</view>
            <view class="star star-5">✦</view>
          </view>
          <!-- 双开书容器 -->
          <view class="book-open-wrapper">
            <!-- 书本阴影 -->
            <view class="book-open-shadow"></view>
            <!-- 左侧页面 -->
            <view class="book-left-page">
              <view class="page-content left-content"></view>
            </view>
            <!-- 书脊 -->
            <view class="book-spine-open"></view>
            <!-- 右侧页面 -->
            <view class="book-right-page">
              <view class="page-content right-content"></view>
            </view>
            <!-- 翻动的书页（从右到左） -->
            <view class="flipping-page-open">
              <view class="flip-page-front"></view>
              <view class="flip-page-back"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 右侧：豆豆数和色彩下拉 -->
      <view class="button-right" wx:if="{{imagePath && processMode === 'cartoon'}}">
        <picker wx:if="{{!useCustomGridSize}}" mode="selector" range="{{gridOptions}}" range-key="name" value="{{gridOptionIndex}}" bindchange="onGridSizeChange">
          <view class="dropdown-btn">
            <text class="dropdown-label">豆豆数</text>
            <text class="dropdown-value">{{gridOptions[gridOptionIndex].name}}</text>
          </view>
        </picker>

        <picker mode="selector" range="{{thresholdOptions}}" range-key="name" value="{{thresholdOptionIndex}}" bindchange="onThresholdChange">
          <view class="dropdown-btn">
            <text class="dropdown-label">色彩</text>
            <text class="dropdown-value">{{thresholdOptions[thresholdOptionIndex].name}}</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- ========================
     自定义 loading 覆盖层
     ======================== -->
  <view class="loading-overlay {{showLoading ? 'show' : ''}} {{exportProgress > 0 ? 'export-loading' : ''}}" catchtouchmove="preventBubbling">
    <view class="loading-box">
      <view class="loading-spinner-ring">
        <view class="spinner-dot dot-1"></view>
        <view class="spinner-dot dot-2"></view>
        <view class="spinner-dot dot-3"></view>
      </view>
      <text class="loading-text">{{loadingText}}</text>
      <view wx:if="{{exportProgress > 0}}" class="loading-progress-bar">
        <view class="loading-progress-fill" style="width: {{exportProgress}}%"></view>
      </view>
    </view>
  </view>

  <!-- 自定义成功提示 -->
  <view class="success-toast {{showSuccessToast ? 'show' : ''}}" catchtouchmove="preventBubbling">
    <view class="success-toast-box">
      <view class="success-icon">✓</view>
      <text class="success-text">{{successToastText}}</text>
    </view>
  </view>

  <!-- ========================
     主预览区域（带小动物贴纸）
     ======================== -->
  <view class="main-wrapper">
    <!-- 小动物贴纸层 -->
    <view class="sticker-layer">
      <text class="sticker sticker-1" style="left: 3%; top: 5%;">🐱</text>
      <text class="sticker sticker-2" style="right: 6%; top: 10%;">🐰</text>
      <text class="sticker sticker-3" style="left: 8%; bottom: 18%;">🐻</text>
      <text class="sticker sticker-4" style="right: 4%; bottom: 22%;">🐶</text>
      <text class="sticker sticker-5" style="left: 45%; top: 3%;">🐼</text>
      <text class="sticker sticker-6" style="right: 12%; bottom: 8%;">🦝</text>
      <text class="sticker sticker-7" style="left: 25%; top: 12%;">🐨</text>
      <text class="sticker sticker-8" style="right: 25%; top: 18%;">🐯</text>
    </view>

    <!-- 预览区 -->
    <view class="preview-area" bindtap="onPreviewAreaClick">
      <mosaicCanvas
        wx:if="{{imagePath}}"
        id="mosaic-canvas"
        imagePath="{{imagePath}}"
        gridSize="{{useCustomGridSize ? customGridSize : gridSize}}"
        forceGridSize="{{useCustomGridSize ? customGridSize : null}}"
        mergeThreshold="{{mergeThreshold}}"
        processMode="{{processMode}}"
        useSpecialColors="{{useSpecialColors}}"
        removeEdge="{{removeEdge}}"
        mirrorImage="{{mirrorImage}}"
        highlightCode="{{highlightCode}}"
        showCode="{{showCode}}"
        previewQuality="{{previewQuality}}"
        regenerateTrigger="{{regenerateTrigger}}"
        vibrantScale="{{vibrantScale}}"
        antiGrayIntensity="{{antiGrayIntensity / 100}}"
        gridPreset="{{[gridPresetIndex, availableGridPresets[gridPresetIndex].cols, availableGridPresets[gridPresetIndex].rows]}}"
        splitMode="{{splitMode}}"
        bind:cellClick="onCodeClick"
        bind:mosaicGenerated="onMosaicGenerated"
        bind:statsUpdate="onStatsUpdate"
        bind:gridInfoUpdate="onGridInfoUpdate"
        bind:loadingChange="onLoadingChange"
      />
      <!-- 空状态 -->
      <view wx:else class="placeholder">
        <text class="placeholder-icon">🎨</text>
        <text class="placeholder-text">点击选择图片生成拼豆图纸</text>
      </view>
    </view>
  </view>

  <!-- ========================
     底部统计面板
     ======================== -->
  <view class="stats-panel" wx:if="{{mosaicData}}">
    <view class="stats-header">
      <text class="stats-title">🐾 颜色统计</text>
      <text class="stats-count">共 {{mosaicData.cols * mosaicData.rows}} 格（{{mosaicData.cols}}列 × {{mosaicData.rows}}行）</text>
    </view>
    <colorStats flatCells="{{flatCells}}" highlightCode="{{highlightCode || ''}}" bind:codeClick="onCodeClick" />
  </view>

  <!-- ========================
     底部悬浮按钮栏
     ======================== -->
  <view class="bottom-fixed-bar" wx:if="{{mosaicData}}">
    <view class="save-btn-full {{isExporting ? 'exporting' : ''}} {{splitMode ? 'has-split' : ''}}" bindtap="exportPNG">
      <view wx:if="{{isExporting}}" class="btn-exporting">
        <view class="export-spinner"></view>
        <text>导出中...</text>
      </view>
      <text wx:if="{{!isExporting && splitMode}}">🐾 导出{{splitModeText}}分块</text>
      <text wx:if="{{!isExporting && !splitMode}}">🐾 保存图片</text>
    </view>
    <view class="split-btn {{splitMode ? 'has-mode' : ''}}" bindtap="toggleSplitPopup">
      <text>{{splitMode ? '重选' : '✂️ 分块导出'}}</text>
    </view>
  </view>

  <!-- ========================
     悬浮设置按钮（右下角）
     ======================== -->
  <view
    wx:if="{{mosaicData}}"
    class="fab-button {{isPanelOpen ? 'fab-close' : ''}}"
    bindtap="toggleSettingsPanel"
  >
    <text class="fab-icon">{{isPanelOpen ? '✕' : '✨'}}</text>
  </view>

  <!-- ========================
     功能面板遮罩
     ======================== -->
  <view
    class="settings-overlay {{isPanelOpen ? 'show' : ''}}"
    bindtap="closeSettingsPanel"
  ></view>

  <!-- ========================
     功能面板（从底部升起，支持拖动缩小）
     ======================== -->
  <view
    class="settings-panel {{isPanelOpen ? 'show' : ''}} {{isPanelMinimized ? 'minimized' : ''}}"
  >
    <!-- 拖动指示条（catch 阻止冒泡，避免影响内容区滚动） -->
    <view class="panel-handle"
      catchtap="onPanelHandleTap"
      catchtouchstart="onPanelTouchStart"
      catchtouchmove="onPanelTouchMove"
      catchtouchend="onPanelTouchEnd"
    >
      <view class="handle-bar"></view>
    </view>

    <!-- 面板标题栏 -->
    <view class="panel-header">
      <view class="panel-title">
        <text class="panel-title-icon">🐱</text>
        <text class="panel-title-text">功能面板</text>
      </view>
      <view class="panel-close" bindtap="closeSettingsPanel">
        <text>✕</text>
      </view>
    </view>

    <!-- 面板内容 -->
    <scroll-view class="panel-content" scroll-y>

      <!-- 第一组：开关按钮 -->
      <view class="setting-group">
        <view class="group-title">🔧 快捷设置</view>
        <view class="switch-row">
          <view
            class="switch-btn {{useSpecialColors ? 'active' : ''}}"
            bindtap="onSpecialColorsChange"
          >
            <text>✨ 特殊色</text>
          </view>
          <view
            class="switch-btn {{removeEdge ? 'active' : ''}}"
            bindtap="onRemoveEdgeChange"
          >
            <text>🪄 去边缘</text>
          </view>
          <view
            class="switch-btn {{mirrorImage ? 'active' : ''}}"
            bindtap="onMirrorChange"
          >
            <text>🔄 镜像</text>
          </view>
        </view>
      </view>

      <!-- 第二组：鲜艳度滑块 -->
      <view class="setting-group">
        <view class="group-title">🎨 鲜艳度</view>
        <view class="vibrant-control">
          <text class="vibrant-label-left">柔和</text>
          <view class="vibrant-slider-outer">
            <view class="vibrant-slider-wrapper">
              <slider
                min="-10"
                max="10"
                value="{{vibrantScale}}"
                bindchange="onVibrantChange"
                block-color="#ff9ecd"
                selected-color="#ffb6d9"
              />
              <view class="vibrant-center-mark"></view>
            </view>
          </view>
          <text class="vibrant-label-right">鲜艳</text>
        </view>
      </view>

      <!-- 网格大小设置（均匀切割模式有效） -->
      <view class="setting-group" wx:if="{{processMode === 'cartoon' || !hasGridLinesDetected}}">
        <view class="group-title">📐 网格大小</view>
        <view class="custom-grid-control">
          <checkbox-group bindchange="onCustomGridToggle">
            <label class="grid-checkbox-label">
              <checkbox value="custom" checked="{{useCustomGridSize}}" />
              <text>自定义网格大小</text>
              <text class="grid-current-value">{{customGridSize}}px</text>
            </label>
          </checkbox-group>
          <view class="grid-control-row {{useCustomGridSize ? '' : 'disabled'}}">
            <text class="grid-min-label">3</text>
            <view class="grid-slider-outer">
              <view class="grid-slider-wrapper">
                <slider
                  min="3"
                  max="50"
                  value="{{customGridSize}}"
                  disabled="{{!useCustomGridSize}}"
                  bindchange="onCustomGridSizeChange"
                  block-color="#ff9ecd"
                  selected-color="#ffb6d9"
                />
              </view>
            </view>
            <text class="grid-max-label">50</text>
          </view>
        </view>
      </view>

      <!-- 网格预设：固定尺寸截取 -->
      <view class="setting-group">
        <view class="group-title">
          <text>📏 网格预设</text>
          <text wx:if="{{mosaicData}}" class="actual-size-inline">实际尺寸：{{mosaicData.cols}}×{{mosaicData.rows}}</text>
        </view>
        <view class="grid-preset-control">
          <text class="preset-hint">选择固定尺寸，从中心截取色块</text>
          <picker mode="selector" range="{{availableGridPresets}}" range-key="name" value="{{gridPresetIndex}}" bindchange="onGridPresetChange">
            <view class="preset-picker-btn">
              <text class="preset-label">网格尺寸</text>
              <text class="preset-value">{{availableGridPresets[gridPresetIndex].name}}</text>
              <text class="preset-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>

      <!-- 浊色规避滑块：偏向高饱和高明度或深色，避开灰浊中间色 -->
      <view class="setting-group">
        <view class="group-title">✨ 浊色规避</view>
        <view class="vibrant-control">
          <text class="vibrant-label-left">关</text>
          <view class="vibrant-slider-outer">
            <view class="vibrant-slider-wrapper">
              <slider
                min="0"
                max="100"
                value="{{antiGrayIntensity}}"
                bindchange="onAntiGrayChange"
                bindchanging="onAntiGrayChanging"
                block-color="{{antiGrayBlockColor}}"
                selected-color="{{antiGrayBlockColor}}"
              />
            </view>
          </view>
          <text class="vibrant-label-right">强</text>
        </view>
      </view>

      <!-- 第三组：替换功能 -->
      <view class="setting-group">
        <view class="group-title">🔄 颜色替换</view>
        <view class="replace-form">
          <view class="replace-row">
            <view class="replace-field">
              <text class="field-label">被替换</text>
              <input
                class="replace-input"
                placeholder="色号"
                value="{{replaceFromCode}}"
                bindinput="onReplaceFromInput"
              />
            </view>
            <text class="replace-arrow">→</text>
            <view class="replace-field">
              <text class="field-label">替换为</text>
              <input
                class="replace-input"
                placeholder="色号"
                value="{{replaceToCode}}"
                bindinput="onReplaceToInput"
              />
            </view>
          </view>

          <view class="replace-options-row">
            <radio-group class="replace-radio-group" bindchange="onReplaceScopeChange">
              <label class="radio-item-inline">
                <radio value="all" checked="{{replaceScope === 'all'}}" color="#10b981" />
                <text>全图</text>
              </label>
              <label class="radio-item-inline">
                <radio value="region" checked="{{replaceScope === 'region'}}" color="#10b981" />
                <text>大区</text>
              </label>
            </radio-group>

            <input
              wx:if="{{replaceScope === 'region'}}"
              class="region-input-inline"
              placeholder="大区编号"
              value="{{replaceRegionCode}}"
              bindinput="onReplaceRegionInput"
            />

            <view class="confirm-btn-small" bindtap="onReplaceConfirm">
              <text>替换</text>
            </view>

            <view class="confirm-btn-small undo-btn" bindtap="onUndo" wx:if="{{canUndo}}">
              <text>撤销</text>
            </view>
          </view>
        </view>
      </view>

    </scroll-view>
  </view>

  <!-- ========================
     分块导出选择弹窗
     ======================== -->
  <view class="split-popup-mask {{showSplitPopup ? 'show' : ''}}" bindtap="hideSplitPopup"></view>
  <view class="split-popup {{showSplitPopup ? 'show' : ''}}">
    <view class="split-popup-title">选择分割方式</view>
    <view class="split-popup-option" bindtap="onSelectSplitMode" data-mode="horizontal">
      <text class="split-option-icon">↕</text>
      <text class="split-option-label">上下分割</text>
      <text class="split-option-desc">从中间水平切开，导出上下两张图</text>
    </view>
    <view class="split-popup-option" bindtap="onSelectSplitMode" data-mode="vertical">
      <text class="split-option-icon">↔</text>
      <text class="split-option-label">左右分割</text>
      <text class="split-option-desc">从中间垂直切开，导出左右两张图</text>
    </view>
    <view class="split-popup-option" bindtap="onSelectSplitMode" data-mode="grid2x2">
      <text class="split-option-icon">🔲</text>
      <text class="split-option-label">2×2 分割</text>
      <text class="split-option-desc">均分为4等份，导出四张图</text>
    </view>
    <view class="split-popup-option" bindtap="onSelectSplitMode" data-mode="grid52">
      <text class="split-option-icon">📦</text>
      <text class="split-option-label">52×52 分块</text>
      <text class="split-option-desc">按52×52色块分块，从左上角开始</text>
    </view>
    <view class="split-popup-option" bindtap="onSelectSplitMode" data-mode="grid104">
      <text class="split-option-icon">📦</text>
      <text class="split-option-label">104×104 分块</text>
      <text class="split-option-desc">按104×104色块分块，从左上角开始</text>
    </view>
    <view class="split-popup-cancel" bindtap="hideSplitPopup">取消</view>
  </view>

  <!-- 隐藏的导出用 canvas -->
  <canvas type="2d" id="export-canvas" style="width: 1px; height: 1px; position: fixed; left: -100px; top: -100px;" />

  <!-- 帮助面板遮罩层 -->
  <view class="help-overlay {{showHelpPanel ? 'show' : ''}}" bindtap="onHelpClose"></view>

  <!-- 帮助面板 -->
  <view class="help-panel {{showHelpPanel ? 'show' : ''}}">
    <!-- 面板标题栏 -->
    <view class="panel-header">
      <view class="panel-title">
        <text class="panel-title-icon">📖</text>
        <text class="panel-title-text">功能说明</text>
      </view>
      <view class="panel-close" bindtap="onHelpClose">
        <text>✕</text>
      </view>
    </view>

    <!-- 面板内容 -->
    <scroll-view class="panel-content" scroll-y="true">
      <!-- 顶部栏功能 -->
      <view class="help-section">
        <view class="help-section-title">顶部工具栏</view>
        <view class="help-item">
          <text class="help-item-icon">🖼️</text>
          <view class="help-item-content">
            <text class="help-item-name">选择图片</text>
            <text class="help-item-desc">从相册或拍照选择图片，生成拼豆图纸</text>
          </view>
        </view>
        <view class="help-item">
          <text class="help-item-icon">🎨</text>
          <view class="help-item-content">
            <text class="help-item-name">卡通/马赛克</text>
            <text class="help-item-desc">切换处理模式，卡通模式保持原图风格（适合普通卡通图），马赛克模式智能识别网格（适合有或者没有色块边界的马赛克图）</text>
          </view>
        </view>
        <view class="help-item">
          <text class="help-item-icon">🔢</text>
          <view class="help-item-content">
            <text class="help-item-name">豆豆数</text>
            <text class="help-item-desc">设置每行/列的拼豆数量，数值越大细节越丰富</text>
          </view>
        </view>
        <view class="help-item">
          <text class="help-item-icon">🌈</text>
          <view class="help-item-content">
            <text class="help-item-name">色彩</text>
            <text class="help-item-desc">设置拼豆颜色最大数量</text>
          </view>
        </view>
      </view>

      <!-- 设置面板功能 -->
      <view class="help-section">
        <view class="help-section-title">设置面板</view>
        <view class="help-item">
          <text class="help-item-icon">⚡</text>
          <view class="help-item-content">
            <text class="help-item-name">快捷设置</text>
            <view class="help-sub-items">
              <view class="help-sub-item">
                <text class="help-sub-icon">✨</text>
                <view class="help-sub-content">
                  <text class="help-sub-name">特殊色</text>
                  <text class="help-sub-desc">启用P/Q/R/T/ZG系列特殊色号，增加颜色选择范围</text>
                </view>
              </view>
              <view class="help-sub-item">
                <text class="help-sub-icon">🪄</text>
                <view class="help-sub-content">
                  <text class="help-sub-name">去边缘</text>
                  <text class="help-sub-desc">去除图片边缘的背景色，只保留主体内容</text>
                </view>
              </view>
              <view class="help-sub-item">
                <text class="help-sub-icon">🔄</text>
                <view class="help-sub-content">
                  <text class="help-sub-name">镜像</text>
                  <text class="help-sub-desc">水平翻转图纸，适合需要镜像效果的图案</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="help-item">
          <text class="help-item-icon">🎨</text>
          <view class="help-item-content">
            <text class="help-item-name">鲜艳度</text>
            <text class="help-item-desc">调节颜色鲜艳程度，正值更鲜艳，负值更柔和</text>
          </view>
        </view>
        <view class="help-item">
          <text class="help-item-icon">📐</text>
          <view class="help-item-content">
            <text class="help-item-name">网格大小</text>
            <text class="help-item-desc">自定义网格像素大小，控制细节程度</text>
          </view>
        </view>
        <view class="help-item">
          <text class="help-item-icon">📏</text>
          <view class="help-item-content">
            <text class="help-item-name">网格预设</text>
            <text class="help-item-desc">选择固定尺寸从中心截取，适配不同拼豆板</text>
          </view>
        </view>
        <view class="help-item">
          <text class="help-item-icon">✨</text>
          <view class="help-item-content">
            <text class="help-item-name">浊色规避</text>
            <text class="help-item-desc">避免使用灰浊的中间色，提升颜色纯净度</text>
          </view>
        </view>
        <view class="help-item">
          <text class="help-item-icon">🔄</text>
          <view class="help-item-content">
            <text class="help-item-name">颜色替换</text>
            <view class="help-sub-items">
              <view class="help-sub-item">
                <text class="help-sub-icon">🌐</text>
                <view class="help-sub-content">
                  <text class="help-sub-name">全图替换</text>
                  <text class="help-sub-desc">将整个图纸中的指定色号替换为新色号</text>
                </view>
              </view>
              <view class="help-sub-item">
                <text class="help-sub-icon">📍</text>
                <view class="help-sub-content">
                  <text class="help-sub-name">大区替换</text>
                  <text class="help-sub-desc">只替换指定大区（如A1、B2等）内的色号，不影响其他区域</text>
                </view>
              </view>
            </view>
          </view>
        </view>
