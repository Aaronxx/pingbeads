<!--pages/index/index.wxml-->
<view class="container">
  <!-- 大外框：宽95%，高98% -->
  <view class="main-wrapper">
    <!-- 按钮行：宽度90% -->
    <view class="button-row">
      <!-- 左侧按钮 -->
      <view class="button-left">
        <imagePicker bind:imageSelected="onImageSelected" bind:imageCleared="onImageCleared" />
      </view>
      
      <!-- 中间设置 -->
      <view class="button-center" wx:if="{{imagePath}}">
        <view class="setting-item">
          <text class="setting-label">精细</text>
          <slider min="1" max="3" step="1" value="{{previewQuality}}" bindchange="onPreviewQualityChange" show-value class="slider-mini" />
        </view>
        <view class="setting-item">
          <text class="setting-label">网格</text>
          <slider min="2" max="50" step="1" value="{{gridSize}}" bindchange="onGridSizeChange" show-value class="slider-mini" />
        </view>
        <view class="setting-item">
          <text class="setting-label">合并</text>
          <slider min="0" max="150" step="5" value="{{mergeThreshold}}" bindchange="onThresholdChange" show-value class="slider-mini" />
        </view>
      </view>
      
      <!-- 右侧预留（给保存按钮） -->
      <view class="button-right" wx:if="{{!mosaicData}}"></view>
    </view>

    <!-- 预览区：宽高90% -->
    <view class="preview-area">
      <mosaicCanvas
        wx:if="{{imagePath}}"
        id="mosaic-canvas"
        imagePath="{{imagePath}}"
        gridSize="{{gridSize}}"
        mergeThreshold="{{mergeThreshold}}"
        highlightCode="{{highlightCode}}"
        showCode="{{showCode}}"
        previewQuality="{{previewQuality}}"
        bind:cellClick="onCodeClick"
        bind:mosaicGenerated="onMosaicGenerated"
      />
      <!-- 空状态 -->
      <view wx:else class="placeholder">
        <text class="placeholder-icon">🎨</text>
        <text class="placeholder-text">选择图片生成马赛克</text>
      </view>
    </view>
  </view>

  <!-- 底部：颜色统计 -->
  <view class="stats-panel" wx:if="{{mosaicData}}">
    <view class="stats-header">
      <text class="stats-title">颜色统计</text>
      <text class="stats-count">共 {{mosaicData.cols * mosaicData.rows}} 格</text>
    </view>
    <colorStats mosaicData="{{mosaicData}}" highlightCode="{{highlightCode}}" bind:codeClick="onCodeClick" />
  </view>

  <!-- 底部悬浮框：宽度与屏幕同宽 -->
  <view class="bottom-fixed-bar" wx:if="{{mosaicData}}">
    <view 
      class="save-btn-full {{isExporting ? 'exporting' : ''}} {{isExporting ? 'disabled' : ''}}" 
      bindtap="exportPNG"
    >
      <text wx:if="{{isExporting}}" class="btn-text exporting-text">导出中...</text>
      <text wx:else class="btn-text">保存图片</text>
    </view>
  </view>
  
  <!-- 隐藏的导出用 canvas -->
  <canvas type="2d" id="export-canvas" style="position: absolute; left: -9999px; top: -9999px;" />
</view>