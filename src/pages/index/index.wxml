<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部固定按钮行 -->
  <view class="top-fixed-bar">
    <!-- 按钮行：宽度90% -->
    <view class="button-row">
      <!-- 左侧按钮：选择图片 + 原图模式 + 设置 -->
      <view class="button-left">
        <imagePicker id="image-picker" bind:imageSelected="onImageSelected" bind:imageCleared="onImageCleared" />
        <!-- 原图模式切换 -->
        <view class="setting-item" wx:if="{{imagePath}}">
          <view class="picker-box mode-switch {{processMode === 'mosaic' ? 'active' : ''}}" bindtap="toggleProcessMode">
            <text class="picker-label">原图</text>
            <text class="picker-value">{{processMode === 'mosaic' ? '马赛克' : '卡通'}}</text>
          </view>
        </view>
        <!-- 左侧设置：网格和色彩（仅卡通模式显示） -->
        <view class="setting-items-left" wx:if="{{imagePath && processMode === 'cartoon'}}">
          <view class="setting-item">
            <picker mode="selector" range="{{gridOptions}}" range-key="name" value="{{gridOptionIndex}}" bindchange="onGridSizeChange">
              <view class="picker-box">
                <text class="picker-label">豆豆数</text>
                <text class="picker-value">{{gridOptions[gridOptionIndex].name}}</text>
              </view>
            </picker>
          </view>
          <view class="setting-item">
            <picker mode="selector" range="{{thresholdOptions}}" range-key="name" value="{{thresholdOptionIndex}}" bindchange="onThresholdChange">
              <view class="picker-box">
                <text class="picker-label">色彩</text>
                <text class="picker-value">{{thresholdOptions[thresholdOptionIndex].name}}</text>
              </view>
            </picker>
          </view>
        </view>
      </view>

      <!-- 右侧按钮：替换和撤销 -->
      <view class="button-right" wx:if="{{mosaicData}}">
        <!-- 替换按钮 -->
        <view class="action-btn replace-btn {{showReplacePanel ? 'active' : ''}}" bindtap="toggleReplacePanel">
          <text>替换</text>
        </view>
        <!-- 撤销按钮 -->
        <view class="action-btn undo-btn {{canUndo ? '' : 'disabled'}}" bindtap="onUndo">
          <text>撤销</text>
        </view>
      </view>

    </view>

    <!-- 第二行：特殊色按钮、去边缘按钮、镜像按钮（卡通模式显示鲜艳滑块） -->
    <view class="special-color-row" wx:if="{{imagePath}}">
      <view class="picker-box mode-switch {{useSpecialColors ? 'active' : ''}}" bindtap="onSpecialColorsChange">
        <text class="picker-label">特殊色</text>
      </view>
      <view class="picker-box mode-switch {{removeEdge ? 'active' : ''}}" bindtap="onRemoveEdgeChange">
        <text class="picker-label">去边缘</text>
      </view>
      <view class="picker-box mode-switch {{mirrorImage ? 'active' : ''}}" bindtap="onMirrorChange">
        <text class="picker-label">镜像</text>
      </view>
      <view class="setting-item vibrant-slider" wx:if="{{processMode === 'cartoon' || processMode === 'mosaic'}}">
        <text class="switch-label">鲜艳</text>
        <slider min="0" max="10" value="{{vibrantScale}}" bindchange="onVibrantChange" show-value block-color="#4CAF50" />
      </view>
    </view>

    <!-- 替换功能面板：展开时显示在按钮行下方 -->
    <view class="replace-panel" wx:if="{{showReplacePanel && mosaicData}}">
      <view class="replace-inputs">
        <input class="replace-input" placeholder="被替换" value="{{replaceFromCode}}" bindinput="onReplaceFromInput" />
        <input class="replace-input" placeholder="替换为" value="{{replaceToCode}}" bindinput="onReplaceToInput" />
      </view>
      <view class="replace-options">
        <radio-group class="replace-radio-group" bindchange="onReplaceScopeChange">
          <label class="radio-label">
            <radio value="all" checked="{{replaceScope === 'all'}}" color="#4CAF50" />
            <text>全图</text>
          </label>
          <label class="radio-label">
            <radio value="region" checked="{{replaceScope === 'region'}}" color="#4CAF50" />
            <text>大区</text>
          </label>
        </radio-group>
      </view>
      <view class="replace-region-input" wx:if="{{replaceScope === 'region'}}">
        <input class="replace-input region-input" placeholder="大区编号（如 A1）" value="{{replaceRegionCode}}" bindinput="onReplaceRegionInput" />
      </view>
      <view class="replace-confirm">
        <view class="confirm-btn" bindtap="onReplaceConfirm">
          <text>确认</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 大外框：宽95%，高98% -->
  <view class="main-wrapper">
    <!-- 预览区：宽高90% -->
    <view class="preview-area" bindtap="onPreviewAreaClick">
      <mosaicCanvas
        wx:if="{{imagePath}}"
        id="mosaic-canvas"
        imagePath="{{imagePath}}"
        gridSize="{{gridSize}}"
        mergeThreshold="{{mergeThreshold}}"
        processMode="{{processMode}}"
        useSpecialColors="{{useSpecialColors}}"
        removeEdge="{{removeEdge}}"
        mirrorImage="{{mirrorImage}}"
        highlightCode="{{highlightCode}}"
        showCode="{{showCode}}"
        previewQuality="{{previewQuality}}"
        regenerateTrigger="{{regenerateTrigger}}"
        vibrantScale="{{vibrantScale}}"
        bind:cellClick="onCodeClick"
        bind:mosaicGenerated="onMosaicGenerated"
        bind:statsUpdate="onStatsUpdate"
      />
      <!-- 空状态 -->
      <view wx:else class="placeholder">
        <text class="placeholder-icon">🎨</text>
        <text class="placeholder-text">选择图片生成拼豆图纸</text>
      </view>
    </view>
  </view>

  <!-- 底部：颜色统计 -->
  <view class="stats-panel" wx:if="{{mosaicData}}">
    <view class="stats-header">
      <text class="stats-title">颜色统计</text>
      <text class="stats-count">共 {{mosaicData.cols * mosaicData.rows}} 格</text>
    </view>
    <colorStats flatCells="{{flatCells}}" highlightCode="{{highlightCode || ''}}" bind:codeClick="onCodeClick" />
  </view>

  <!-- 底部悬浮框：宽度与屏幕同宽 -->
  <view class="bottom-fixed-bar" wx:if="{{mosaicData}}">
    <view 
      class="save-btn-full {{isExporting ? 'exporting' : ''}} {{isExporting ? 'disabled' : ''}}" 
      bindtap="exportPNG"
    >
      <text wx:if="{{isExporting}}" class="btn-text exporting-text">导出中...</text>
      <text wx:else class="btn-text">保存图片</text>
    </view>
  </view>
  
  <!-- 隐藏的导出用 canvas - 使用 type="2d" -->
  <canvas type="2d" id="export-canvas" style="width: 1px; height: 1px; position: fixed; left: -100px; top: -100px;" />
</view>